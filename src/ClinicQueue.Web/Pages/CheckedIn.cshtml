@page "{id:int}"
@model CheckedInModel
@{
    ViewData["Title"] = "Checked in";
}

<div class="text-center">
    <h1>You're checked in</h1>
    <p class="lead">Thanks, @Model.Entry.Patient.FullName. Please take a seat.</p>
    <p class="mb-1">Your ticket number</p>
    <p class="display-3 font-weight-bold">@Model.Entry.TicketNumber</p>
    <p>Your code: <code class="lookup-code">@Model.Entry.LookupCode</code></p>
</div>
