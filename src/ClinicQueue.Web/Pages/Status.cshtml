@page "{code?}"
@model StatusModel
@{
    ViewData["Title"] = "Queue status";
}

<h1>Queue status</h1>

@if (Model.Entry == null)
{
    <form method="get" class="form-inline mb-3">
        <label class="mr-2" for="code">Your code</label>
        <input id="code" name="code" class="form-control mr-2 text-uppercase" value="@Model.Code" maxlength="12" autocomplete="off" />
        <button type="submit" class="btn btn-primary">Look up</button>
    </form>

    @if (Model.NotFoundCode)
    {
        <div class="alert alert-warning">We couldn't find that code. Please check it, or ask at the front desk.</div>
    }
}
else
{
    @if (Model.CheckedIn)
    {
        <div class="alert alert-success">You're checked in. Please take a seat &mdash; we'll call your number.</div>
    }

    <div id="queue-status" class="card queue-status @(Model.Entry.Status == QueueStatus.Called ? "is-called" : "")"
         data-poll-url="@Url.Page("/Status", "Position", new { code = Model.Entry.LookupCode })">
        <div class="card-body text-center">
            <p class="mb-1 text-muted">Your ticket</p>
            <p class="ticket-number">@Model.Entry.TicketNumber</p>
            <p class="mb-3">Code <code class="lookup-code">@Model.Entry.LookupCode</code></p>

            <dl class="row queue-facts mb-0">
                <dt class="col-6 text-right">Status</dt>
                <dd class="col-6 text-left" data-field="status">@Model.Entry.Status.Label()</dd>
                <dt class="col-6 text-right">Place in queue</dt>
                <dd class="col-6 text-left" data-field="position">@(Model.Position?.ToString() ?? "–")</dd>
            </dl>

            <p class="called-message">Your number has been called &mdash; please come to the front desk.</p>
        </div>
    </div>
    <p class="text-muted small mt-2">This page updates automatically.</p>
}

@section Scripts {
    @if (Model.Entry != null && !Model.Entry.Status.IsFinal())
    {
        <script src="~/js/status-poll.js" asp-append-version="true"></script>
    }
}
