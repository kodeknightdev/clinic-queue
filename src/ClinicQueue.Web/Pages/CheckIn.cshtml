@page
@model CheckInModel
@{
    ViewData["Title"] = "Check in";
}

<h1>Check in</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" class="checkin-form">
            <div class="form-group">
                <label asp-for="Input.FullName"></label>
                <input asp-for="Input.FullName" class="form-control" />
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Phone"></label>
                <input asp-for="Input.Phone" class="form-control" />
                <span asp-validation-for="Input.Phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.DateOfBirth"></label>
                <input asp-for="Input.DateOfBirth" class="form-control" />
                <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Reason"></label>
                <textarea asp-for="Input.Reason" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Input.Reason" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <input asp-for="Input.IsPriority" class="form-check-input" />
                <label asp-for="Input.IsPriority" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg">Check in</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
