@if (User.Identity.IsAuthenticated)
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <span class="navbar-text text-dark mr-3">@(User.FindFirst("display_name")?.Value ?? User.Identity.Name)</span>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Staff/Logout">Sign out</a>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Staff/Login">Staff sign in</a>
        </li>
    </ul>
}
