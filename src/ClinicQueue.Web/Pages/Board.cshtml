@page
@model BoardModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Queue board</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/board.css" asp-append-version="true" />
</head>
<body class="board">
    <div class="board-columns">
        <section class="board-now">
            <h1>Now serivng</h1>
            <ul>
                @foreach (var entry in Model.NowServing)
                {
                    <li><span class="board-ticket">@entry.TicketNumber</span> <span class="board-name">@entry.Patient.FullName</span></li>
                }
            </ul>
        </section>
        <section class="board-next">
            <h2>Up next</h2>
            <ul>
                @foreach (var entry in Model.UpNext)
                {
                    <li><span class="board-ticket">@entry.TicketNumber</span> <span class="board-name">@entry.Patient.FullName</span></li>
                }
            </ul>
        </section>
    </div>
</body>
</html>
